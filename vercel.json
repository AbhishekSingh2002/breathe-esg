{
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "routePrefix": "/_/backend",
      "framework": "django",
      "installCommand": "pip install -r requirements.txt",
      "buildCommand": "python manage.py collectstatic --noinput"
    }
  }
}
